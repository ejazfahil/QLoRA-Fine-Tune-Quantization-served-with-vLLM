# Copy to .env and fill in. Never commit .env.

# Hugging Face token (needed for gated bases like meta-llama/Llama-2-7b-hf).
# Mistral-7B-v0.3 is open and does not require this.
HF_TOKEN=

# Experiment tracking. Leave REPORT_TO=none to disable (default).
# REPORT_TO=wandb
WANDB_API_KEY=
WANDB_PROJECT=qlora-vllm-pipeline

# vLLM server endpoint used by the eval/serve clients.
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY
